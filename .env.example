# Google OAuth / YouTube API credentials
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3" and "YouTube Analytics API"
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized redirect URI: http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Session encryption secret (use a long, random string in production)
SESSION_SECRET=change_this_to_a_secure_random_string

# Server configuration
PORT=3000
NODE_ENV=development

# Upload limits
MAX_FILE_SIZE_MB=200

